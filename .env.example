# Copy to .env and fill in. NEVER commit .env.
# Only VITE_-prefixed vars reach the browser bundle — they are PUBLIC.
# Anything secret must live in the hosting provider's env settings, not here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_CALLBACK_URL=http://localhost:5173/auth/callback

# Server-only (never prefix these with VITE_)
# GOOGLE_PROJECT_ID=
# GOOGLE_CREDENTIALS_JSON=
# ALLOWED_ORIGINS=https://preview.example.com

# Optional: comma-separated addresses allowed past the institute-mail
# pattern (e.g. society admin accounts). PUBLIC — the RLS policy in
# SECURITY.md is what actually enforces access.
# VITE_AUTH_EMAIL_ALLOWLIST=
